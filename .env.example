# Server-only. Supply a local/test PostgreSQL database; never commit real credentials.
DATABASE_URL=
# Generate a random secret for session CSRF protection. Never use a sample secret.
AUTH_SECRET=

# Exact public origin, no trailing slash. Required for API mutations.
APP_ORIGIN=
# Set true only behind an ingress that removes/replaces X-Forwarded-For.
TRUST_PROXY_IP=false
# Explicit business-policy activation; leave empty until the store approves per-block pricing.
RENTAL_PRICING_MODE=
RENTAL_PRICING_VERSION=
RENTAL_QUOTE_TTL_SECONDS=300
