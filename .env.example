# Set http to use implemented SQL services, then rebuild. Mock is a separate demo.
NEXT_PUBLIC_RENTAL_API_MODE=mock
# Server-only. Supply a local/test PostgreSQL database; never commit real credentials.
DATABASE_URL=
# Generate a random secret before enabling Auth.js. Never use a sample secret.
AUTH_SECRET=
# OIDC: choose a provider and enter its verified HTTPS issuer and credentials.
# No provider credentials or fake accounts are included.

# Exact public origin, no trailing slash. Required for API mutations.
APP_ORIGIN=
# Set true only behind an ingress that removes/replaces X-Forwarded-For.
TRUST_PROXY_IP=false
# Auth.js can trust the known reverse proxy only after deployment is configured.
# Handler pins APP_ORIGIN; do not set AUTH_URL/AUTH_TRUST_HOST.
AUTH_CUSTOMER_OIDC_ISSUER=
AUTH_CUSTOMER_OIDC_CLIENT_ID=
AUTH_CUSTOMER_OIDC_CLIENT_SECRET=
AUTH_ADMIN_OIDC_ISSUER=
AUTH_ADMIN_OIDC_CLIENT_ID=
AUTH_ADMIN_OIDC_CLIENT_SECRET=
# Explicit business-policy activation; leave empty until the store approves per-block pricing.
RENTAL_PRICING_MODE=
RENTAL_PRICING_VERSION=
RENTAL_QUOTE_TTL_SECONDS=300
