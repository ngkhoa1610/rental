{
  "name": "rental-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.jsx",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run db:validate && npm run format:check && npm run lint && npm test && npm run test:server && npm run build && npm run test:smoke && npm run test:security",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:security": "npm audit --audit-level=moderate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "test:integration": "node scripts/integration-test.mjs",
    "staff:provision": "node --conditions=react-server --import tsx scripts/provision-staff.ts",
    "db:maintenance": "node --conditions=react-server --import tsx scripts/db-maintenance.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotenv": "18.0.4",
    "lucide-react": "^1.43.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
